{
  "manifest_version": 3,
  "name": "Sealbook",
  "version": "0.1.0",
  "description": "Save the page you are on as a sealed bookmark in your Sealbook vault.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sealbook@silentsphinx",
      "strict_min_version": "121.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to Sealbook",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "theme_icons": [
      {
        "dark": "icons/icon-16-charcoal.png",
        "light": "icons/icon-16-white.png",
        "size": 16
      },
      {
        "dark": "icons/icon-32-charcoal.png",
        "light": "icons/icon-32-white.png",
        "size": 32
      }
    ]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'none'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "idle",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
